# Copy to .env to override. Defaults are the measured recipe — every default
# below has a receipted measurement behind it (docs/PERFORMANCE.md).

# Public arm64 runtime image (B12X attention, pinned vLLM fork + EXL3).
IMAGE=ghcr.io/0xsero/glm53-b12x-exl3:b12x-mtp-1xspark-v1

# Public weights (provenance-verified twin of the K2 staging artifact).
WEIGHTS_REPO=0xSero/GLM-5.3-Flash-EXL3-TR3-2.0bpw

# Where weights and the derived MTP view live.
# WEIGHTS_DIR=models/GLM-5.3-Flash-EXL3-TR3-2.0bpw
# MTP_DIR=mtp

PORT=8888
CONTEXT_LEN=262144
MEM_FRACTION=0.93

# Native MTP draft depth. 2 is the measured recipe; 1 is the conservative fallback.
SPEC_DEPTH=2

# EXL3 trellis dequant tile cap. 32 is the receipted default; raising it to 128
# was measured (E1, 2026-09-17) to be prefill-neutral and acceptance-neutral-negative.
TRELLIS_MAX_M=32
# Chunked-prefill chunk size. 7168 measured +8.9% prefill at 4k and +4.4% at 131k
# vs 2048 (E2, 2026-09-18), decode unchanged — this is the shipped default.
MAX_NUM_BATCHED_TOKENS=7168

# Optional; only needed to avoid Hugging Face rate limits on the 111 GB download.
# Never committed, never logged.
# HF_TOKEN=
